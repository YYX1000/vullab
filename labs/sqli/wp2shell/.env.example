# ============================================================
# wp2shell 靶场版本变量配置（复用 labs/cms/wordpress 模式）
#   ⭐ 修改 WORDPRESS_IMAGE 的镜像 tag 即可切换受影响版本
# ============================================================

# ---------- WordPress 版本（wp2shell 受影响版本，Docker Hub 官方镜像 tag） ----------
# 影响范围（修复版：7.0.2 / 6.9.5）：
#   6.9.0 – 6.9.4   受影响
#   7.0.0 – 7.0.1   受影响
# 可用 tag（apache 变体，php8.2~php8.4 可选）：
#   wordpress:7.0.1-php8.4-apache   ← 默认，受影响
#   wordpress:6.9.4-php8.3-apache   ← 6.9 线末期，受影响
#   wordpress:6.9.2-php8.3-apache   ← 受影响
#   wordpress:6.9-php8.3-apache     ← 6.9.0，受影响
#   wordpress:7.0.2-php8.4-apache   ← 修复版本，可作对照复现
WORDPRESS_IMAGE=wordpress:7.0.1-php8.4-apache

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# ---------- 访问端口（容器内 80 映射；PoC 运行时将 URL 指向该端口） ----------
WEB_PORT=8093
