# ============================================================
# ruoyi-vue-pro（java8）版本变量配置
#   基于 YunaiV/ruoyi-vue-pro master 分支（SpringSecurity + SpringBoot2.7 + JDK8）
#   前端为独立仓库 yudaocode/yudao-ui-admin-vue3（Vue3 + Vite + pnpm）
#   ⭐ 修改 YUDAO_BRANCH 即可切换版本（master 为 JDK8 体系）
# ============================================================

# ---------- 后端源码版本（git 分支） ----------
# YunaiV/ruoyi-vue-pro 仓库
YUDAO_REPO=https://github.com/YunaiV/ruoyi-vue-pro.git
# master 分支：JDK8 + SpringBoot2.7 + SpringSecurity
YUDAO_BRANCH=master

# ---------- 前端源码版本 ----------
# yudao-ui-admin-vue3 前端（Vue3 + ElementPlus + Vite + pnpm）
FRONTEND_REPO=https://github.com/yudaocode/yudao-ui-admin-vue3.git
FRONTEND_BRANCH=master

# 构建产物镜像标签
IMAGE_TAG=master

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.42
# ruoyi-vue-pro 默认库名
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=root

# ---------- Redis（ruoyi-vue-pro 强依赖，验证码/缓存/会话） ----------
REDIS_IMAGE=redis:7-alpine

# ---------- 前端访问端口（nginx 映射到容器内 80） ----------
WEB_PORT=8084
