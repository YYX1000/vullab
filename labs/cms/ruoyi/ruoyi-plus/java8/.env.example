# ============================================================
# RuoYi-Vue-Plus（java8）版本变量配置
#   基于 dromara/RuoYi-Vue-Plus v4.8.3（Sa-Token + SpringBoot2.7 + JDK8）
#   前端与后端同仓库（ruoyi-ui-vue3，Vue3 + Vite）
#   ⭐ 修改 RUOYI_BRANCH 即可切换若依 Plus 版本（v4.x 均为 JDK8 体系）
# ============================================================

# ---------- 后端/前端源码版本（git tag） ----------
# dromara/RuoYi-Vue-Plus 仓库
RUOYI_REPO=https://github.com/dromara/RuoYi-Vue-Plus.git
# v4.x 系列：JDK8 + SpringBoot2.7 + Sa-Token
RUOYI_BRANCH=v4.8.3
# 前端与后端同仓库，前端位于 ruoyi-ui-vue3 子目录（无需单独指定前端仓库）

# 构建产物镜像标签
IMAGE_TAG=4.8.3

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.42
# RuoYi-Vue-Plus 默认库名
MYSQL_DATABASE=ry-vue
MYSQL_ROOT_PASSWORD=root

# ---------- Redis（RuoYi-Vue-Plus 强依赖，验证码/缓存/会话） ----------
REDIS_IMAGE=redis:7-alpine

# ---------- 前端访问端口（nginx 映射到容器内 80） ----------
WEB_PORT=8082
