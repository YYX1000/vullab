# ============================================================
# RuoYi-Vue-Plus（java17）版本变量配置
#   基于 dromara/RuoYi-Vue-Plus v5.6.2（Sa-Token + SpringBoot3 + JDK17）
#   前端为独立仓库 JavaLionLi/plus-ui（Vue3 + Vite）
#   ⭐ 修改 RUOYI_BRANCH 即可切换若依 Plus 版本（v5.x 均为 JDK17 体系，
#      对应前端 tag 需同步切换为 v{X.Y.Z}-v{a.b.c} 格式）
# ============================================================

# ---------- 后端源码版本（git tag） ----------
# dromara/RuoYi-Vue-Plus 仓库
RUOYI_REPO=https://github.com/dromara/RuoYi-Vue-Plus.git
# v5.x 系列：JDK17 + SpringBoot3 + Sa-Token
RUOYI_BRANCH=v5.6.2

# ---------- 前端源码版本（v5 起前端为独立仓库 plus-ui） ----------
# 官方前端 plus-ui（Vue3 + ElementPlus + Vite）
# tag 格式 v{后端版本}-v{前端版本}，v5.6.2 后端对应 v5.6.2-v2.6.2
FRONTEND_REPO=https://github.com/JavaLionLi/plus-ui.git
FRONTEND_BRANCH=v5.6.2-v2.6.2

# 构建产物镜像标签
IMAGE_TAG=5.6.2

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.42
# RuoYi-Vue-Plus 默认库名
MYSQL_DATABASE=ry-vue
MYSQL_ROOT_PASSWORD=root

# ---------- Redis（RuoYi-Vue-Plus 强依赖，验证码/缓存/会话） ----------
REDIS_IMAGE=redis:7-alpine

# ---------- 前端访问端口（nginx 映射到容器内 80） ----------
WEB_PORT=8083
