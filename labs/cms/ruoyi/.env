# ============================================================
# RuoYi-Vue 版本变量配置（官方若依源码）
# ============================================================

# ---------- 源码版本（git 分支 / 标签） ----------
# 后端 RuoYi-Vue（官方若依，Spring Boot + Vue3 对应的 Java 后端）
RUOYI_REPO=https://gitee.com/y_project/RuoYi-Vue.git
RUOYI_BRANCH=master

# 前端 RuoYi-Vue3（官方若依 Vue3 前端）
RUOYI_UI_REPO=https://gitcode.com/yangzongzhuan/RuoYi-Vue3.git
RUOYI_UI_BRANCH=master

# 构建产物镜像标签
IMAGE_TAG=3.9.2

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.42
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue
MYSQL_ROOT_PASSWORD=root

# ---------- Redis ----------
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
REDIS_PASSWORD=ruoyi123

# ---------- 后端 ----------
BACKEND_PORT=8080

# ---------- 前端 Nginx ----------
WEB_PORT=8080
