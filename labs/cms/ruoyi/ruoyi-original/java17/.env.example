# ============================================================
# RuoYi-Vue 官方原版（java17）版本变量配置
#   前后端分离：SpringBoot3 + JDK17（springboot3 分支，jakarta 体系）
#   ⭐ 修改下方 RUOYI_BRANCH 即可切换若依后端版本：
#      springboot3 —— SpringBoot 3.x + JDK17（默认）
# ============================================================

# ---------- 后端源码版本（git 分支 / 标签） ----------
# 官方 RuoYi-Vue（前后端分离）后端仓库
RUOYI_REPO=https://github.com/yangzongzhuan/RuoYi-Vue.git
# 切换若依后端版本：springboot3（SpringBoot3 + JDK17）
RUOYI_BRANCH=springboot3

# ---------- 前端源码版本（springboot3 分支已拆分为独立前端仓库） ----------
# RuoYi-Vue2 前端（Vue2 + Element UI + Vue CLI，与 v3.x 一致风格）
FRONTEND_REPO=https://github.com/yangzongzhuan/RuoYi-Vue2.git
FRONTEND_BRANCH=master

# 构建产物镜像标签
IMAGE_TAG=3.9.2

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.42
# RuoYi-Vue 默认库名（注意：是 ry-vue，不是 ry）
MYSQL_DATABASE=ry-vue
MYSQL_ROOT_PASSWORD=root

# ---------- Redis（RuoYi-Vue 强依赖，验证码/缓存/会话） ----------
REDIS_IMAGE=redis:7-alpine

# ---------- 前端访问端口（nginx 映射到容器内 80） ----------
WEB_PORT=8081
