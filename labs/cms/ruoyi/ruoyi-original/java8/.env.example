# ============================================================
# RuoYi-Vue 官方原版（java8）版本变量配置
#   前后端分离：SpringBoot2 + JDK8
#   ⭐ 修改下方 GIT_BRANCH 即可切换若依版本：
#      v3.7.0 —— Shiro 安全框架
#      v3.9.0 —— SpringSecurity + JWT（默认）
# ============================================================

# ---------- 源码版本（git 分支 / 标签） ----------
# 官方 RuoYi-Vue（前后端分离）仓库
RUOYI_REPO=https://github.com/yangzongzhuan/RuoYi-Vue.git
# 切换若依版本：v3.7.0(Shiro) / v3.9.0(SpringSecurity-JWT)
RUOYI_BRANCH=v3.9.0

# 构建产物镜像标签
IMAGE_TAG=3.9.0

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.42
# RuoYi-Vue 默认库名（注意：是 ry-vue，不是 ry）
MYSQL_DATABASE=ry-vue
MYSQL_ROOT_PASSWORD=root

# ---------- Redis（RuoYi-Vue 强依赖，验证码/缓存/会话） ----------
REDIS_IMAGE=redis:7-alpine

# ---------- 前端访问端口（nginx 映射到容器内 80） ----------
WEB_PORT=8080
