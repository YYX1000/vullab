# ============================================================
# WordPress 4.x 时代（PHP5.6 + MySQL5.6）版本变量配置
#   ⭐ 修改 WORDPRESS_IMAGE 的镜像 tag 即可切换 WordPress 版本
# ============================================================

# ---------- WordPress 版本（Docker Hub 官方镜像 tag） ----------
# 4.7 线可用版本（apache 变体，PHP 运行时可选 php5.6 / php7.0 / php7.1）：
#   wordpress:4.7.1-php5.6-apache   ← 默认，REST API 内容注入 CVE-2017-1001000 漏洞版本（4.7.0/4.7.1）
#   wordpress:4.7.2-php5.6-apache   ← CVE-2017-1001000 修复版本，可作对照
#   wordpress:4.7.5-php5.6-apache   ← 4.7 分支最终安全版本
# 完整 tag 列表: https://hub.docker.com/_/wordpress/tags
WORDPRESS_IMAGE=wordpress:4.7.1-php5.6-apache

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:5.6
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8086
