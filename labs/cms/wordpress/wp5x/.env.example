# ============================================================
# WordPress 5.x 时代（PHP7.2 + MySQL5.7）版本变量配置
#   ⭐ 修改 WORDPRESS_IMAGE 的镜像 tag 即可切换 WordPress 版本
# ============================================================

# ---------- WordPress 版本（Docker Hub 官方镜像 tag） ----------
# 5.x 线可用版本（apache 变体）：
#   wordpress:5.0.2-php7.2-apache   ← Gutenberg 块编辑器首发版本（5.0 线，PHP 运行时可选 php5.6~php7.3）
#   wordpress:5.0.3-php7.2-apache   ← 默认，5.0 线最终安全版本
#   wordpress:5.5.0-php7.4-apache   ← 5.5 线（原生延迟加载、REST API 认证）
#   wordpress:5.8.3-php7.4-apache   ← 5.8 分支最终安全版本（php7.3~php8.1 可选）
# 完整 tag 列表: https://hub.docker.com/_/wordpress/tags
WORDPRESS_IMAGE=wordpress:5.0.3-php7.2-apache

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:5.7
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8087
