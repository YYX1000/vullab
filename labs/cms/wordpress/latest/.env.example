# ============================================================
# WordPress 当前主线（PHP8.4 + MySQL8.0）版本变量配置
#   ⭐ 修改 WORDPRESS_IMAGE 的镜像 tag 即可切换 WordPress 版本
# ============================================================

# ---------- WordPress 版本（Docker Hub 官方镜像 tag） ----------
# 主线与 6.x 线可用版本（apache 变体）：
#   wordpress:7.1.0-php8.4-apache
#   wordpress:7.1-php8.4-apache     ← 默认，当前主线最新
#   wordpress:6.5.0-php8.2-apache   ← 6.5 线（php8.1~php8.3 可选）
#   wordpress:6.4.3-php8.2-apache   ← 6.4 分支最终安全版本（php8.1~php8.3 可选）
# 完整 tag 列表: https://hub.docker.com/_/wordpress/tags
WORDPRESS_IMAGE=wordpress:7.1-php8.4-apache

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8088
