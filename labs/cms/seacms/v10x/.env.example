# ============================================================
# SeaCMS 10.x 时代（PHP7.4 + MySQL5.7）版本变量配置
#   ⭐ 修改 SEACMS_ZIP_URL 即可切换版本（GitHub 归档完整安装包）
# ============================================================

# ---------- SeaCMS 版本（完整安装包 zip 地址） ----------
# 10.x 时代可用归档：
#   https://raw.githubusercontent.com/seacms-net/CMS/10.1/seacms%2010.1.zip  ← 默认，v10.1
SEACMS_ZIP_URL=https://raw.githubusercontent.com/seacms-net/CMS/10.1/seacms%2010.1.zip

# 构建产物镜像标签
IMAGE_TAG=10.1

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:5.7
MYSQL_DATABASE=seacms_db
MYSQL_USER=seacms
MYSQL_PASSWORD=seacms123
MYSQL_ROOT_PASSWORD=root123456

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8090
