# ============================================================
# SeaCMS 13.x 当前版本线（PHP7.4 + MySQL5.7）版本变量配置
#   ⭐ 修改 SEACMS_ZIP_URL 即可切换版本（官方安装包目录）
# ============================================================

# ---------- SeaCMS 版本（完整安装包 zip 地址） ----------
# 13.x 当前线可用版本（官网安装包目录仅保留 13.3–13.5）：
#   https://www.seacms.net/download/安装包/SeaCMS_V13.3_install.zip  ← 默认，v13.3（有公开 SQL 注入研究）
#   https://www.seacms.net/download/安装包/SeaCMS_V13.4_install.zip  ← v13.4
#   https://www.seacms.net/download/安装包/SeaCMS_V13.5_install.zip  ← v13.5（当前最新）
SEACMS_ZIP_URL=https://www.seacms.net/download/%E5%AE%89%E8%A3%85%E5%8C%85/SeaCMS_V13.3_install.zip

# 构建产物镜像标签
IMAGE_TAG=13.3

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:5.7
MYSQL_DATABASE=seacms_db
MYSQL_USER=seacms
MYSQL_PASSWORD=seacms123
MYSQL_ROOT_PASSWORD=root123456

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8092
