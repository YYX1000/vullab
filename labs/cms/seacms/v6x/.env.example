# ============================================================
# SeaCMS 6.x 时代（PHP5.6 + MySQL5.6）版本变量配置
#   ⭐ 修改 SEACMS_REPO 即可切换 6.x 时代版本（GitHub 归档源码树）
# ============================================================

# ---------- SeaCMS 版本（git 源码仓库） ----------
# 6.x 时代可用归档：
#   https://github.com/V1ntLyn/seacms6.54.git   ← 默认，v6.54（前台 GetShell 公开研究覆盖版本）
#   https://github.com/MyPHPTools/seacms.git    ← v6.58（6 线后期版本）
SEACMS_REPO=https://github.com/V1ntLyn/seacms6.54.git

# 构建产物镜像标签
IMAGE_TAG=6.54

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:5.6
MYSQL_DATABASE=seacms_db
MYSQL_USER=seacms
MYSQL_PASSWORD=seacms123
MYSQL_ROOT_PASSWORD=root123456

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8089
