# ============================================================
# SeaCMS 12.x 时代（PHP7.4 + MySQL5.7）版本变量配置
#   ⭐ 修改 SEACMS_ZIP_URL 即可切换版本（GitHub 归档完整安装包）
# ============================================================

# ---------- SeaCMS 版本（完整安装包 zip 地址） ----------
# 12.x 时代可用归档：
#   https://raw.githubusercontent.com/seacms-net/CMS/master/SeaCMS_12.9_%E6%B5%B7%E6%B4%8BCMS%E5%AE%89%E8%A3%85%E5%8C%85.zip  ← 默认，v12.9（12 线末期版本）
#   https://raw.githubusercontent.com/seacms-net/CMS/v12.5/%E6%B5%B7%E6%B4%8BCMS_%E5%AE%89%E8%A3%85%E5%8C%85_v12.5.zip      ← v12.5
SEACMS_ZIP_URL=https://raw.githubusercontent.com/seacms-net/CMS/master/SeaCMS_12.9_%E6%B5%B7%E6%B4%8BCMS%E5%AE%89%E8%A3%85%E5%8C%85.zip

# 构建产物镜像标签
IMAGE_TAG=12.9

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:5.7
MYSQL_DATABASE=seacms_db
MYSQL_USER=seacms
MYSQL_PASSWORD=seacms123
MYSQL_ROOT_PASSWORD=root123456

# ---------- 访问端口（容器内 80 映射） ----------
WEB_PORT=8091
